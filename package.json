{
  "name": "cube-practice",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @cube-practice/web dev",
    "build": "pnpm --filter @cube-practice/web build",
    "start": "pnpm --filter @cube-practice/web start",
    "check": "vp check .",
    "format": "vp fmt . --write",
    "format:check": "vp fmt . --check",
    "lint": "vp lint . --deny-warnings",
    "test": "pnpm --recursive test",
    "typecheck": "vp check --no-fmt --no-lint .",
    "preview": "pnpm --filter @cube-practice/web preview",
    "deploy": "pnpm --filter @cube-practice/web deploy",
    "upload": "pnpm --filter @cube-practice/web upload",
    "cf-typegen": "pnpm --filter @cube-practice/web cf-typegen"
  },
  "devDependencies": {
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.20.0"
}
